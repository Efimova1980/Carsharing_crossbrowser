<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="apisuite" verbose="1" configfailurepolicy="continue">
    <test name="apitests">
        <groups>
            <run>
                <include name="api"/>
            </run>
        </groups>
        <classes>
            <class name="api_tests.RegistrationApiTests"/>
            <class name="api_tests.LoginApiTests"/>
            <class name="api_tests.SearchApiTests"/>
            <class name="api_tests.AddCarApiTests"/>
            <class name="api_tests.DeleteCarApiTests"/>
        </classes>
    </test>
</suite>
