<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="suite1" verbose="1" configfailurepolicy="continue">
    <test name="regressiontests">
        <groups>
            <run>
                <include name="regression"/>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="ui_tests.RegistrationTests"/>
            <class name="ui_tests.LoginTests"/>
            <class name="ui_tests.AddCarTests"/>
            <class name="ui_tests.FindYourCarTests"/>
            <class name="ui_tests.NavigationTests"/>
        </classes>
    </test>
</suite>