<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Each <test> runs in its own browser; parallel="tests" runs the browsers at the same time.
     thread-count = how many browsers work simultaneously (not more than free slots in the grid). -->
<suite name="crossbrowser" verbose="1" parallel="tests" thread-count="3">
    <test name="chrome">
        <parameter name="browser" value="chrome"/>
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="ui_tests.RegistrationTests"/>
            <class name="ui_tests.LoginTests"/>
            <class name="ui_tests.AddCarTests"/>
            <class name="ui_tests.FindYourCarTests"/>
        </classes>
    </test>
    <test name="firefox">
        <parameter name="browser" value="firefox"/>
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="ui_tests.RegistrationTests"/>
            <class name="ui_tests.LoginTests"/>
            <class name="ui_tests.AddCarTests"/>
            <class name="ui_tests.FindYourCarTests"/>
        </classes>
    </test>
    <test name="edge">
        <parameter name="browser" value="edge"/>
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="ui_tests.RegistrationTests"/>
            <class name="ui_tests.LoginTests"/>
            <class name="ui_tests.AddCarTests"/>
            <class name="ui_tests.FindYourCarTests"/>
        </classes>
    </test>
</suite>
