<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- The same tests as crossbrowser_regression_parallel.xml, but without parallel runs:
     Chrome first, then Firefox, then Edge, one test at a time.
     Used to compare the run time with the parallel suite. -->
<suite name="crossbrowser_regression_sequential" verbose="1" configfailurepolicy="continue">
    <test name="chrome">
        <parameter name="browser" value="chrome"/>
        <groups>
            <run>
                <include name="regression"/>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="ui_tests.RegistrationTests"/>
            <class name="ui_tests.LoginTests"/>
            <class name="ui_tests.AddCarTests"/>
            <class name="ui_tests.FindYourCarTests"/>
            <class name="ui_tests.NavigationTests"/>
        </classes>
    </test>
    <test name="firefox">
        <parameter name="browser" value="firefox"/>
        <groups>
            <run>
                <include name="regression"/>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="ui_tests.RegistrationTests"/>
            <class name="ui_tests.LoginTests"/>
            <class name="ui_tests.AddCarTests"/>
            <class name="ui_tests.FindYourCarTests"/>
            <class name="ui_tests.NavigationTests"/>
        </classes>
    </test>
    <test name="edge">
        <parameter name="browser" value="edge"/>
        <groups>
            <run>
                <include name="regression"/>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="ui_tests.RegistrationTests"/>
            <class name="ui_tests.LoginTests"/>
            <class name="ui_tests.AddCarTests"/>
            <class name="ui_tests.FindYourCarTests"/>
            <class name="ui_tests.NavigationTests"/>
        </classes>
    </test>
</suite>
