<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Regression + smoke in three browsers. Each <test> runs in its own browser;
     parallel="tests" runs the browsers at the same time, inside a browser tests run one by one. -->
<suite name="crossbrowser_regression" verbose="1" parallel="tests" thread-count="3">
    <test name="chrome">
        <parameter name="browser" value="chrome"/>
        <groups>
            <run>
                <include name="regression"/>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="ui_tests.RegistrationTests"/>
            <class name="ui_tests.LoginTests"/>
            <class name="ui_tests.AddCarTests"/>
            <class name="ui_tests.FindYourCarTests"/>
            <class name="ui_tests.NavigationTests"/>
        </classes>
    </test>
    <test name="firefox">
        <parameter name="browser" value="firefox"/>
        <groups>
            <run>
                <include name="regression"/>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="ui_tests.RegistrationTests"/>
            <class name="ui_tests.LoginTests"/>
            <class name="ui_tests.AddCarTests"/>
            <class name="ui_tests.FindYourCarTests"/>
            <class name="ui_tests.NavigationTests"/>
        </classes>
    </test>
    <test name="edge">
        <parameter name="browser" value="edge"/>
        <groups>
            <run>
                <include name="regression"/>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="ui_tests.RegistrationTests"/>
            <class name="ui_tests.LoginTests"/>
            <class name="ui_tests.AddCarTests"/>
            <class name="ui_tests.FindYourCarTests"/>
            <class name="ui_tests.NavigationTests"/>
        </classes>
    </test>
</suite>
